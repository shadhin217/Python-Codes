 def determine_performance(attendance, quiz, assignment, final):
    total_score = attendance + quiz + assignment + final
    if total_score >= 80:
        performance_level = "Outstanding"
    elif total_score >= 75:
        performance_level = "Excellent"
    elif total_score >= 70:
        performance_level = "Very Good"
    elif total_score >= 65:
        performance_level = "Good"
    elif total_score >= 60:
        performance_level = "Satisfactory"
    elif total_score >= 55:
        performance_level = "Developing"
    elif total_score >= 50:
        performance_level = "Fair"
    elif total_score >= 45:
        performance_level = "Below Average"
    elif total_score >= 40:
        performance_level = "At Risk"
    else:
        performance_level = "Needs Improvement"

    return total_score, performance_level
